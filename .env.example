# Required for email notifications.
# Get this from Resend after creating an API key.
RESEND_API_KEY=

# Required for email notifications.
# Sender shown to clients. The domain must be verified in Resend.
RESEND_FROM=

# Required for salon notifications.
# Real inboxes where booking/contact requests should arrive.
# Use commas for multiple inboxes.
SALON_INTAKE_EMAIL=

# Required for saving booking/contact requests and powering /admin.
# SUPABASE_URL is the same value as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# Required server-only Supabase key.
# Use Supabase secret/service role key. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Required for /admin login.
# Single-admin setup:
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Optional multi-admin setup.
# Format: username=passwordHash,username2=passwordHash
# If ADMIN_USERS is set, ADMIN_USERNAME/ADMIN_PASSWORD_HASH can be left empty.
ADMIN_USERS=

# Required for signing secure /admin session cookies.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=
